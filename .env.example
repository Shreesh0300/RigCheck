# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"
MONGODB_DB_NAME=rigcheck_db

# Frontend Application URL (used for OAuth callbacks and redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
# Authorized redirect URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Steam OpenID & Web API Settings
# (Optional Steam API key for avatar & persona fetch: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
STEAM_RETURN_URL=http://localhost:5173/auth/steam/callback

# Session Secret Key
SESSION_SECRET=your_random_session_secret_key_here
